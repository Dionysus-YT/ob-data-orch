{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "paths": { "@/*": ["./src/*"] },
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "vite.platform.config.ts", "eslint.config.js", "playwright.config.ts", "tests/*.spec.ts"]
}
